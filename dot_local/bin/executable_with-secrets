#!/bin/sh
# 認証情報を環境に載せてからコマンドを exec するラッパー。
#
# 用途:
#   MCPサーバーの起動コマンドをこれで包むと、サーバープロセスが確実に認証情報を
#   受け取れる。
#
#     command = "/Users/<user>/.local/bin/with-secrets"
#     args = ["uv", "run", "--directory", "...", "socialdata-mcp"]
#
# なぜ必要か:
#   認証情報の正本は 1Password で、chezmoi が ~/.zsh/secrets.zsh へ展開している。
#   しかしMCPサーバーはホスト（Claude Code / Codex）が spawn するため、
#   起動元シェルの環境変数が子プロセスへ渡るかはホストの実装依存で、確認できていない。
#   実際に SocialData MCP が 401 を返した（APIキー自体は curl で200を確認済み）。
#   ここで明示的に読み込めば、その依存がなくなる。
#
#   代替案は各ホストの設定ファイルへ認証情報をリテラルで書くことだが、
#   ~/.claude.json と ~/.codex/config.toml はどちらもツール自身が書き換える
#   揮発ファイルで chezmoi 管理外のため、正本が2箇所に増える。

set -eu

secrets="${HOME}/.zsh/secrets.zsh"
if [ -r "$secrets" ]; then
    # shellcheck disable=SC1090
    . "$secrets"
fi

if [ "$#" -eq 0 ]; then
    echo "with-secrets: コマンドが指定されていません" >&2
    exit 64
fi

exec "$@"
