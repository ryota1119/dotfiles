{
  "main guard": {
    "prefix": "main",
    "body": [
      "def main() -> None:",
      "\t${1:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "\tmain()"
    ],
    "description": "main guard with main() entrypoint"
  },
  "try/except": {
    "prefix": "try",
    "body": [
      "try:",
      "\t${1:pass}",
      "except ${2:Exception} as ${3:e}:",
      "\t${4:raise}"
    ],
    "description": "try/except"
  },
  "try/except/finally": {
    "prefix": "tryf",
    "body": [
      "try:",
      "\t${1:pass}",
      "except ${2:Exception} as ${3:e}:",
      "\t${4:raise}",
      "finally:",
      "\t${5:pass}"
    ],
    "description": "try/except/finally"
  },
  "function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2}) -> ${3:None}:",
      "\t${4:pass}"
    ],
    "description": "function with type hints"
  },
  "async function": {
    "prefix": "adef",
    "body": [
      "async def ${1:name}(${2}) -> ${3:None}:",
      "\t${4:pass}"
    ],
    "description": "async function with type hints"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "\tdef __init__(self${2:, }) -> None:",
      "\t\t${3:pass}"
    ],
    "description": "class with __init__"
  },
  "dataclass": {
    "prefix": "dcls",
    "body": [
      "from dataclasses import dataclass",
      "",
      "",
      "@dataclass(slots=True)",
      "class ${1:Name}:",
      "\t${2:field}: ${3:str}"
    ],
    "description": "dataclass with slots"
  },
  "logger": {
    "prefix": "log",
    "body": [
      "import logging",
      "",
      "logger = logging.getLogger(__name__)"
    ],
    "description": "module-level logger"
  },
  "pytest test": {
    "prefix": "test",
    "body": [
      "def test_${1:case}() -> None:",
      "\t${2:assert True}"
    ],
    "description": "pytest test function"
  }
}
