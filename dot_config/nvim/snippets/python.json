{
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}"
    ],
    "description": "if statement"
  },
  "if/else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}",
      "else:",
      "\t${3:pass}"
    ],
    "description": "if/else statement"
  },
  "if/elif/else": {
    "prefix": "ifel",
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}",
      "elif ${3:condition}:",
      "\t${4:pass}",
      "else:",
      "\t${5:pass}"
    ],
    "description": "if/elif/else statement"
  },
  "main guard": {
    "prefix": "main",
    "body": [
      "def main() -> None:",
      "\t${1:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "\tmain()"
    ],
    "description": "main guard with main() entrypoint"
  },
  "try/except": {
    "prefix": "try",
    "body": [
      "try:",
      "\t${1:pass}",
      "except ${2:Exception} as ${3:e}:",
      "\t${4:raise}"
    ],
    "description": "try/except"
  },
  "try/except/finally": {
    "prefix": "tryf",
    "body": [
      "try:",
      "\t${1:pass}",
      "except ${2:Exception} as ${3:e}:",
      "\t${4:raise}",
      "finally:",
      "\t${5:pass}"
    ],
    "description": "try/except/finally"
  },
  "function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2}) -> ${3:None}:",
      "\t${4:pass}"
    ],
    "description": "function with type hints"
  },
  "async function": {
    "prefix": "adef",
    "body": [
      "async def ${1:name}(${2}) -> ${3:None}:",
      "\t${4:pass}"
    ],
    "description": "async function with type hints"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "\tdef __init__(self${2:, }) -> None:",
      "\t\t${3:pass}"
    ],
    "description": "class with __init__"
  },
  "dataclass": {
    "prefix": "dcls",
    "body": [
      "from dataclasses import dataclass",
      "",
      "",
      "@dataclass(slots=True)",
      "class ${1:Name}:",
      "\t${2:field}: ${3:str}"
    ],
    "description": "dataclass with slots"
  },
  "logger": {
    "prefix": "log",
    "body": [
      "import logging",
      "",
      "logger = logging.getLogger(__name__)"
    ],
    "description": "module-level logger"
  },
  "pytest test": {
    "prefix": "test",
    "body": [
      "def test_${1:case}() -> None:",
      "\t${2:assert True}"
    ],
    "description": "pytest test function"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:iterable}:",
      "\t${3:pass}"
    ],
    "description": "for loop"
  },
  "for enumerate": {
    "prefix": "fore",
    "body": [
      "for ${1:i}, ${2:x} in enumerate(${3:iterable}):",
      "\t${4:pass}"
    ],
    "description": "for loop with enumerate"
  },
  "for dict items": {
    "prefix": "forr",
    "body": [
      "for ${1:k}, ${2:v} in ${3:d}.items():",
      "\t${4:pass}"
    ],
    "description": "for loop over dict items"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "\t${2:pass}"
    ],
    "description": "while loop"
  },
  "with": {
    "prefix": "with",
    "body": [
      "with ${1:expr} as ${2:f}:",
      "\t${3:pass}"
    ],
    "description": "with statement"
  },
  "async with": {
    "prefix": "aswith",
    "body": [
      "async with ${1:expr} as ${2:f}:",
      "\t${3:pass}"
    ],
    "description": "async with statement"
  },
  "list comprehension": {
    "prefix": "lc",
    "body": [
      "[${1:expr} for ${2:x} in ${3:iterable}]"
    ],
    "description": "list comprehension"
  },
  "dict comprehension": {
    "prefix": "dc",
    "body": [
      "{${1:k}: ${2:v} for ${3:k}, ${4:v} in ${5:iterable}.items()}"
    ],
    "description": "dict comprehension"
  },
  "property": {
    "prefix": "prop",
    "body": [
      "@property",
      "def ${1:name}(self) -> ${2:str}:",
      "\treturn self._${1:name}"
    ],
    "description": "property getter"
  },
  "type alias": {
    "prefix": "ta",
    "body": [
      "type ${1:Alias} = ${2:str}"
    ],
    "description": "type alias (Python 3.12+)"
  },
  "dotenv": {
    "prefix": "env",
    "body": [
      "import os",
      "from dotenv import load_dotenv",
      "",
      "load_dotenv()",
      "${1:value} = os.getenv(\"${2:KEY}\")"
    ],
    "description": "load_dotenv and getenv"
  },
  "match/case": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "\tcase ${2:pattern}:",
      "\t\t${3:pass}",
      "\tcase _:",
      "\t\t${4:pass}"
    ],
    "description": "match/case statement (Python 3.10+)"
  }
}
