# =============================================================================
# 個人固有のGit設定
# このファイルは個人の環境に合わせてカスタマイズしてください
# =============================================================================

[user]
    name = {{ onepasswordRead "op://Personal/GitHub.Personal/username" "my.1password.com" }}
    email = {{ onepasswordRead "op://Personal/GitHub.Personal/email" "my.1password.com" }}
    signingkey = {{ onepasswordRead "op://Personal/id_ed25519/public_key" "my.1password.com" }}

# 1Password SSH署名設定
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[ghq]
	root = /Users/{{ .chezmoi.username }}/Src
