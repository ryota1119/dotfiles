{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "google-calendar": {
      "type": "remote",
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "enabled": true
    },
    "gmail": {
      "type": "remote",
      "url": "https://gmailmcp.googleapis.com/mcp/v1",
      "enabled": true
    },
    "google-drive": {
      "type": "remote",
      "url": "https://drivemcp.googleapis.com/mcp/v1",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    },
    "xapi": {
      "type": "local",
      "command": ["npx", "-y", "@xdevplatform/xurl", "mcp", "https://api.x.com/mcp"],
      "enabled": true,
      // 参照先は個人アカウントのPersonalボルト。git identityは会社アカウントを
      // 使うマシンがあるため、アカウント指定は personalOnepasswordAccount を使う。
      "environment": {
        "CLIENT_ID": {{ onepasswordRead "op://Personal/X Developer Client Secret/username" .personalOnepasswordAccount | quote }},
        "CLIENT_SECRET": {{ onepasswordRead "op://Personal/X Developer Client Secret/password" .personalOnepasswordAccount | quote }}
      }
    },
    "hn-mcp": {
      "type": "local",
      "command": ["uv", "run", "--directory", "{env:HOME}/Workspace/repos/github.com/RayLabOrg/hn-mcp", "hn-mcp"],
      "enabled": true
    },
    "qiita-mcp": {
      "type": "local",
      "command": ["uv", "run", "--directory", "{env:HOME}/Workspace/repos/github.com/RayLabOrg/qiita-mcp", "qiita-mcp"],
      "enabled": true
    },
    "zenn-mcp": {
      "type": "local",
      "command": ["uv", "run", "--directory", "{env:HOME}/Workspace/repos/github.com/RayLabOrg/zenn-mcp", "zenn-mcp"],
      "enabled": true
    },
    "socialdata-mcp": {
      "type": "local",
      "command": ["uv", "run", "--directory", "{env:HOME}/Workspace/repos/github.com/RayLabOrg/socialdata-mcp", "socialdata-mcp"],
      "enabled": true,
      "environment": {
        "SOCIALDATA_API_KEY": {{ onepasswordRead "op://Personal/SocialData/api_key" .personalOnepasswordAccount | quote }}
      }
    }
  }
}
