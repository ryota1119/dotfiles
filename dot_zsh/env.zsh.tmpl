{{- /* Homebrew prefix（macOS Apple Silicon / Intel / Linuxbrew 対応） */ -}}
{{- $brewPrefix := "/opt/homebrew" -}}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
{{-   $brewPrefix = "/usr/local" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $brewPrefix = "/home/linuxbrew/.linuxbrew" -}}
{{- end -}}
# =============================================================================
# 環境変数・PATH 設定
# =============================================================================

# -----------------------------------------------------------------------------
# XDG Base Directory
# -----------------------------------------------------------------------------
export XDG_CONFIG_HOME="$HOME/.config"

# -----------------------------------------------------------------------------
# PATH
# -----------------------------------------------------------------------------
# bison: mise 経由で php をインストールする際に必要
export PATH="{{ $brewPrefix }}/opt/bison/bin:$PATH"

# -----------------------------------------------------------------------------
# mise (バージョン管理)
# -----------------------------------------------------------------------------
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# -----------------------------------------------------------------------------
# direnv
# -----------------------------------------------------------------------------
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# -----------------------------------------------------------------------------
# エディタ
# -----------------------------------------------------------------------------
export EDITOR=nvim

# -----------------------------------------------------------------------------
# claude-obsidian（Exocortex vault）
# -----------------------------------------------------------------------------
export CLAUDE_OBSIDIAN_VAULT="$HOME/Workspace/exocortex"

# -----------------------------------------------------------------------------
# fzf
# -----------------------------------------------------------------------------
export FZF_DEFAULT_OPTS='--height 40% --reverse --border'
export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/*"'
export FZF_ALT_C_OPTS="--preview 'tree -C {} | head -200'"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
{{ if eq .ai.provider "openrouter" }}
# -----------------------------------------------------------------------------
# Claude Code バックエンド（OpenRouter 経由）
# -----------------------------------------------------------------------------
# 個人マシン専用。会社マシンは ai.provider = "anthropic" のため、このブロックは出力されない。
#
# CLAUDE_CODE_SUBAGENT_MODEL と CLAUDE_CODE_EFFORT_LEVEL は意図的に設定していない。
#   - CLAUDE_CODE_SUBAGENT_MODEL は subagent frontmatter の model 指定を上書きする
#   - CLAUDE_CODE_EFFORT_LEVEL は skill/subagent frontmatter の effort 指定を上書きする
# DeepSeek・OpenRouter の公式サンプルにはどちらも含まれているが、そのまま採用すると
# ~/.claude/agents/*.md の設計(source-readerだけ effort: medium 等)が丸ごと無効化される。
# sonnetエイリアス経由で解決させることで、既存の model: sonnet 指定がそのまま活きる。
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_API_KEY=""
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

export ANTHROPIC_MODEL="deepseek/deepseek-v4-pro-0813"
export ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek/deepseek-v4-pro-0813"
export ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek/deepseek-v4-pro-0813"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek/deepseek-v4-flash"

# APIキーはシェル環境に常駐させず、claude起動時に1Passwordから解決する(functions.zsh の claude ラッパ)
export OP_ACCOUNT_FOR_AI={{ .gitIdentity.onepasswordAccount | quote }}
export OP_OPENROUTER_KEY_PATH={{ .ai.openrouterKeyPath | quote }}
{{ end -}}
