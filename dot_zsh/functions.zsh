# =============================================================================
# Zsh関数定義
# =============================================================================

# ディレクトリ作成と移動を同時に行う
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# ファイルの内容を表示してから編集
v() {
  if [ -f "$1" ]; then
    cat "$1" | vim -
  else
    vim "$1"
  fi
}

# プロセスをポート番号で検索
port() {
  lsof -i :"$1"
}

# ディレクトリサイズを表示
ds() {
  du -sh "$1" 2>/dev/null | sort -hr
}

# Gitブランチを一覧表示
gb() {
  git branch -a | grep -v "remotes/origin/HEAD" | sed 's/^[* ]*//'
}

# 最近使用したディレクトリに移動
cdr() {
  local dir
  dir=$(cdr -l | sed 's/^[0-9]* *//' | fzf)
  if [ -n "$dir" ]; then
    cd "$dir"
  fi
}

