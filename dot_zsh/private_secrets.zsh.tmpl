# MCPサーバーへ渡す認証情報。
#
# 設計上の判断:
#   - Claude Code の ~/.claude.json と Codex の ~/.codex/config.toml は、どちらも
#     ツール自身が書き換える揮発ファイルのため chezmoi 管理下に置けない。両方に
#     リテラルで秘密情報を持たせると正本が2箇所に増える。
#   - そこでシェル環境変数に寄せ、MCPサーバーのプロセスへ継承させる。正本は
#     1Password の1箇所だけになる。
#   - 値は chezmoi apply 時に onepasswordRead で埋め込む。シェル起動ごとに
#     `op read` を走らせると毎回の認証と遅延が発生するため、実行時参照はしない。
#   - 埋め込む以上このファイルは平文になるので、chezmoi の private_ 接頭辞で
#     パーミッション600にしている。git管理されるのはテンプレートだけで、
#     展開後の値はリポジトリに入らない。
#
# 新しい認証情報を追加するときは、1Passwordへ登録してからここに export を足す。
# 追加後は、参照する側（~/.claude.json / ~/.codex/config.toml）の env ブロックを
# 削除して継承に切り替える。

# SocialData（X の投稿検索・ツイート詳細・Article本文取得。socialdata-mcp が使う）
export SOCIALDATA_API_KEY={{ onepasswordRead .mcpSecrets.socialdataApiKey .personalOnepasswordAccount | quote }}

# X (Twitter) Developer。xapi MCP と xurl が使う
export CLIENT_ID={{ onepasswordRead .mcpSecrets.xClientId .personalOnepasswordAccount | quote }}
export CLIENT_SECRET={{ onepasswordRead .mcpSecrets.xClientSecret .personalOnepasswordAccount | quote }}
