{{/* PCごとに異なる1Password参照先を保持する設定。初回のchezmoi apply/init時にのみ質問され、
     以降は ~/.config/chezmoi/chezmoi.toml に保存された値がそのまま使われる。
     1Passwordで複数アカウントに同時サインインする運用のため、op readにどのアカウントを
     使うか明示する必要がある(account未指定だと "multiple accounts found" エラーになる)。
     値は op://Personal/... の参照先が属するアカウントのURL/email/UUID等を指定する。
     キー名は "onepassword" だとchezmoi組み込みの予約データ(op連携設定)と衝突するため gitIdentity にしている。 */}}
[data.gitIdentity]
    onepasswordAccount        = {{ promptStringOnce . "gitIdentity.onepasswordAccount" "1Password account for git identity (URL/email/UUID)" "my.1password.com" | quote }}
    onepasswordUsernamePath   = {{ promptStringOnce . "gitIdentity.onepasswordUsernamePath" "1Password path (git username)" "op://Personal/GitHub - ryota1119/username" | quote }}
    onepasswordEmailPath      = {{ promptStringOnce . "gitIdentity.onepasswordEmailPath" "1Password path (git email)" "op://Personal/GitHub - ryota1119/email" | quote }}
    onepasswordSigningKeyPath = {{ promptStringOnce . "gitIdentity.onepasswordSigningKeyPath" "1Password path (SSH signing public key)" "op://Personal/id_ed25519/public_key" | quote }}
